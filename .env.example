# Quorate environment. Copy to .env and fill. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox > Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled after the webhook is registered for the Render URL (Phase 4)
PAYPAL_WEBHOOK_ID=

# Sandbox personal accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
VENDOR_COACH_EMAIL=
VENDOR_MUSEUM_EMAIL=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# Model (Google AI Studio key) ; LLM_BACKEND = gemini | anthropic | replay
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BACKEND=replay

# Database (Render Postgres external URL for local runs; Render injects it in production)
DATABASE_URL=

# Public site
PUBLIC_BASE_URL=http://localhost:3000

# Safety locks
QUORATE_LIVE=on
LIVE_MAX_CLOSES_PER_DAY=20

# Render (dashboard > Account Settings > API Keys) for deploy checks only
RENDER_API_KEY=
